# ── API CLIENT (src/lib/api.js) ──────────────────────────────

Three functions. All wrap fetch in try/catch.
All show toast.error on failure and return null.

processDocument(file):
  FormData with field "pdf" → POST /api/process-document
  Returns full response data including prompts and document_summary

startSession({ system_prompt, greeting }):
  FormData with system_prompt, greeting, name="defense-panel-"+Date.now()
  POST /api/start-session
  Returns { agent_id, agent_embed_url, agent_name }

endSession({ transcript_text, agent_id, scenario_type, duration_seconds }):
  JSON POST /api/end-session
  Returns { grades }

