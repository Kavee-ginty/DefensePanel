{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "functions": {
    "api/process-document.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/end-session.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/start-session.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/start-call.js": {
      "memory": 256,
      "maxDuration": 20
    },
    "api/create-checkout.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/sessions/index.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/sessions/[id].js": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|src/|node_modules/|@).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
