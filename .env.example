# Frontend (Vite) — required for login and local History (direct Supabase + RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: force local dev to use /api instead of direct Supabase (requires vercel dev on port 3000)
# VITE_USE_API_SESSIONS=true

# Serverless API (Vercel production only — do not prefix with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
