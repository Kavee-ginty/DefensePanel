# Copy to `.env` for local development only. Never commit real secrets.

# Beyond Presence (server-side only — used by Vercel `/api`, never prefixed with VITE_)
BEYOND_PRESENCE_API_KEY=
BEYOND_PRESENCE_API_BASE_URL=https://api.bey.dev

# Optional: pin two formal avatars for consistent demos (from dashboard / GET /v1/avatars)
BEYOND_INTERROGATOR_AVATAR_ID=
BEYOND_EVALUATOR_AVATAR_ID=

# OpenAI (server-side — `/api/process-document`, `/api/end-session`)
OPENAI_API_KEY=

# Supabase (server-side service role for writes from `/api`)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend public (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
