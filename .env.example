# Copy this file to `.env` and fill in values. Do not commit `.env`.

# --- Local dev: Vite proxies /api here when running `npm run dev` ---
# Run `npm run dev:api` (vercel dev :3000) or set this to your deployed Vercel URL.
# Example: https://your-app.vercel.app or http://127.0.0.1:3000 (if something serves /api there)
DEV_API_ORIGIN=http://127.0.0.1:3000

# --- Vite / client (exposed in the browser; must use VITE_ prefix) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional legacy (AvatarView no longer uses agent_id fallback for embed)
VITE_BEYOND_AGENT_EMBED_BASE=

# --- Server only (Vercel `/api` — never use VITE_ prefix) ---
BEYOND_PRESENCE_API_KEY=
# Required for POST /v1/agents (see Bey SDK AgentCreateParams)
BEY_AVATAR_ID=
# Chat iframe base for agent embeds (default https://bey.chat)
BEY_CHAT_EMBED_ORIGIN=https://bey.chat
# Optional: POST multipart PDF after agent creation. Use {agent_id} placeholder if needed.
# BEY_KNOWLEDGE_UPLOAD_URL=https://api.bey.dev/v1/agents/{agent_id}/knowledge_files
OPENAI_API_KEY=
