# =====================================================================
# Frontend (Vite) — required for login and local History (Supabase + RLS)
# =====================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: force local dev to call /api/sessions instead of querying
# Supabase directly from the browser (requires `vercel dev` on port 3000).
# VITE_USE_API_SESSIONS=true

# Dodo Payments checkout gateway (Express server in /dodo, default :8080)
VITE_DODO_API_URL=http://localhost:8080

# =====================================================================
# Serverless API (Vercel) — do NOT prefix with VITE_
# =====================================================================

# Supabase (used by /api/sessions and /api/end-session via service role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — used by /api/process-document (PDF → prompts) and
# /api/end-session (grade transcript). Get a key at platform.openai.com.
OPENAI_API_KEY=sk-...

# Beyond Presence — used by /api/start-session (create agent) and
# /api/end-session (delete agent). Avatar id is the persona to clone.
BEYOND_PRESENCE_API_KEY=bp_...
BEY_AVATAR_ID=your-bey-avatar-id

# Optional override for the bey.chat embed origin. Defaults to https://bey.chat
# BEY_CHAT_EMBED_ORIGIN=https://bey.chat

# =====================================================================
# Local development proxy (vite.config.js reads this)
# =====================================================================
# Where vite should proxy /api/* requests in dev. Run `vercel dev` on
# this port (default 3000) in a second terminal alongside `npm run dev`.
# DEV_API_ORIGIN=http://127.0.0.1:3000
